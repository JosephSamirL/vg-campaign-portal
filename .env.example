# Browser + server (public). From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The two below are seed-only — local machine, never Vercel.
# Supavisor session pooler (port 5432), used by scripts/seed for COPY.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Vitest isolation twin (tests/isolation.test.ts) — put these in the git-ignored `.env.test`,
# never here or in `.env.local`. They must point at the LOCAL stack (`supabase start`:
# URL 127.0.0.1:54321, publishable key from `supabase status`) and at the KILELE analyst's
# local password (credentials.txt entry under the local host). The test skips with a warning
# when they are missing, fails under CI, and refuses a non-local URL unless ALLOW_HOSTED_TESTS=1.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
TEST_KILELE_ANALYST_EMAIL=kilele.analyst@vg-eval.test
TEST_KILELE_ANALYST_PASSWORD=<local password from credentials.txt>
