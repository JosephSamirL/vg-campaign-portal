# Browser + server (public). From Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The two below are seed-only — local machine, never Vercel.
# Supavisor session pooler (port 5432), used by scripts/seed for COPY.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Vitest isolation twin (tests/isolation.test.ts) — put these in the git-ignored `.env.test`,
# never here or in `.env.local`. They must point at the LOCAL stack (`supabase start`:
# URL 127.0.0.1:54321, publishable key from `supabase status`) and at the KILELE analyst's
# local password (credentials.txt entry under the local host). The test skips with a warning
# when they are missing, fails under CI, and refuses a non-local URL unless ALLOW_HOSTED_TESTS=1.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
TEST_KILELE_ANALYST_EMAIL=kilele.analyst@vg-eval.test
TEST_KILELE_ANALYST_PASSWORD=<local password from credentials.txt>

# Story 4.2 — tests/send-concurrency.test.ts signs in as the KILELE OWNER (a real password session; the
# service key would skip the role check) and as the analyst above. `signInAs(brand, role)` (tests/setup.ts)
# reads TEST_<BRAND>_<ROLE>_EMAIL/_PASSWORD first, then the local `credentials.127.0.0.1-54321.txt` that
# `pnpm seed` writes, then the legacy `credentials.txt`. Teardown deletes the test send through the local
# service role: TEST_SUPABASE_SERVICE_ROLE_KEY when set, otherwise read from `supabase status -o env`.
TEST_KILELE_OWNER_EMAIL=kilele.owner@vg-eval.test
TEST_KILELE_OWNER_PASSWORD=<local password from credentials.127.0.0.1-54321.txt>
#TEST_SUPABASE_SERVICE_ROLE_KEY=<local service role key from `supabase status`; optional>

# Story 4.3 — the dispatch half of tests/send-concurrency.test.ts also signs in as the KAROO owner (cross-brand
# 404) — set a local password for karoo.owner@vg-eval.test through the local Admin API, as for the KILELE owner.
TEST_KAROO_OWNER_EMAIL=karoo.owner@vg-eval.test
TEST_KAROO_OWNER_PASSWORD=<local password>
# The cron-secret path is asserted with the value the served function was given (read from supabase/mock.env
# by default); override only if you serve with another env file.
#TEST_CRON_SECRET=local-cron-secret
# Edge Function secrets are NOT app env: hosted → `supabase secrets set PROVIDER_BASE_URL=… PROVIDER_API_KEY=…
# CRON_SECRET=…`; local → the git-ignored `supabase/.env` (real provider, Story 6.1's probe only) or the committed
# `supabase/mock.env` (the provider mock — what `pnpm test` expects). See README, "Dispatch".
